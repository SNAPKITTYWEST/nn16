10 REM NN/16 INTEGER BASIC REPL
20 REM APPLE II INTEGER BASIC / WOZ STYLE
30 REM ONE STATEMENT PER LINE
40 REM NO ELSE, NO FLOAT, NO MODERN SYNTAX
50 DIM W1(12)
60 DIM B1(3)
70 DIM W2(3)
80 DIM B2(1)
90 DIM X(4)
100 DIM H(3)
110 DIM DS(40)
120 DIM TG(10)
130 NIN=4
140 NH=3
150 NOUT=1
160 SEED=1
170 LR=16
180 EP=0
190 NS=0
200 GOSUB 9000
210 PRINT "NN/16 INTEGER BASIC"
220 PRINT "TYPE H FOR HELP"
230 INPUT "CMD: ";C$
240 IF C$="H" THEN GOSUB 1000
250 IF C$="N" THEN GOSUB 2000
260 IF C$="D" THEN GOSUB 3000
270 IF C$="E" THEN GOSUB 3500
280 IF C$="W" THEN GOSUB 4000
290 IF C$="A" THEN GOSUB 4500
300 IF C$="R" THEN GOSUB 5000
310 IF C$="T" THEN GOSUB 6000
320 IF C$="P" THEN GOSUB 6500
330 IF C$="F" THEN GOSUB 7000
340 IF C$="S" THEN GOSUB 7500
350 IF C$="L" THEN GOSUB 8000
360 IF C$="G" THEN GOSUB 8500
370 IF C$="V" THEN GOSUB 8600
380 IF C$="X" THEN END
390 GOTO 230
1000 REM HELP
1010 PRINT "H HELP"
1020 PRINT "N NEW MODEL"
1030 PRINT "D LOAD DATASET"
1040 PRINT "E ENTER SAMPLE"
1050 PRINT "W SHOW WEIGHTS"
1060 PRINT "A SHOW ACTIVATIONS"
1070 PRINT "R RUN SAMPLE"
1080 PRINT "T TRAIN"
1090 PRINT "P SHOW PARAMETERS"
1100 PRINT "F FLETCHER"
1110 PRINT "S SAVE"
1120 PRINT "L LOAD"
1130 PRINT "G EXPORT LOGO"
1140 PRINT "V VERIFY"
1150 PRINT "X EXIT"
1160 RETURN
2000 REM NEW MODEL
2010 SEED=1
2020 GOSUB 9100
2030 PRINT "MODEL INITIALIZED SEED=";SEED
2040 RETURN
3000 REM LOAD DATASET (HARDCODED DEMO)
3010 NS=4
3020 DS(1)=128:DS(2)=0:DS(3)=0:DS(4)=0:TG(1)=50
3030 DS(5)=0:DS(6)=128:DS(7)=0:DS(8)=0:TG(2)=50
3040 DS(9)=0:DS(10)=0:DS(11)=128:DS(12)=0:TG(3)=50
3050 DS(13)=64:DS(14)=64:DS(15)=64:DS(16)=0:TG(4)=75
3060 PRINT "DATASET LOADED NS=";NS
3070 RETURN
3500 REM ENTER SAMPLE
3510 PRINT "X0 X1 X2 X3 TARGET"
3520 INPUT X(1)
3530 INPUT X(2)
3540 INPUT X(3)
3550 INPUT X(4)
3560 INPUT T
3570 PRINT "STORED"
3580 RETURN
4000 REM SHOW WEIGHTS
4010 PRINT "W1:"
4020 FOR I=1 TO NH
4030 FOR J=1 TO NIN
4040 K=(I-1)*NIN+J
4050 PRINT W1(K);" ";
4060 NEXT J
4070 PRINT
4080 NEXT I
4090 PRINT "B1:"
4100 FOR I=1 TO NH
4110 PRINT B1(I);" ";
4120 NEXT I
4130 PRINT
4140 PRINT "W2:"
4150 FOR J=1 TO NH
4160 PRINT W2(J);" ";
4170 NEXT J
4180 PRINT
4190 PRINT "B2=";B2(1)
4200 RETURN
4500 REM SHOW ACTIVATIONS
4510 PRINT "X:";X(1);X(2);X(3);X(4)
4520 PRINT "H:";H(1);H(2);H(3)
4530 PRINT "O=";O
4540 RETURN
5000 REM RUN SAMPLE (FORWARD)
5010 GOSUB 9200
5020 PRINT "OUTPUT=";O
5030 RETURN
6000 REM TRAIN ONE EPOCH
6010 IF NS=0 THEN PRINT "NO DATA":RETURN
6020 FOR S=1 TO NS
6030 X(1)=DS((S-1)*4+1)
6040 X(2)=DS((S-1)*4+2)
6050 X(3)=DS((S-1)*4+3)
6060 X(4)=DS((S-1)*4+4)
6070 T=TG(S)
6080 GOSUB 9200
6090 GOSUB 9300
6100 NEXT S
6110 EP=EP+1
6120 PRINT "EPOCH ";EP;" DONE"
6130 RETURN
6500 REM SHOW PARAMETERS
6510 PRINT "NIN=";NIN;" NH=";NH;" NOUT=";NOUT
6520 PRINT "SEED=";SEED;" LR=";LR;" EP=";EP
6530 RETURN
7000 REM FLETCHER PLACEHOLDER
7010 PRINT "FLETCHER-16 NOT FULLY IMPLEMENTED IN BASIC DEMO"
7020 PRINT "SEE PASCAL SERIALIZATION KERNEL"
7030 RETURN
7500 REM SAVE PLACEHOLDER
7510 PRINT "SAVE: USE PASCAL SERIALIZATION FOR FULL IMAGE"
7520 RETURN
8000 REM LOAD PLACEHOLDER
8010 PRINT "LOAD: USE PASCAL DESERIALIZE"
8020 RETURN
8500 REM EXPORT LOGO
8510 PRINT "[[INPUT X1 X2 X3 X4]"
8520 PRINT " [HIDDEN H0 H1 H2]"
8530 PRINT " [OUTPUT O0]]"
8540 RETURN
8600 REM VERIFY
8610 GOSUB 9400
8620 RETURN
9000 REM INIT DEFAULT WEIGHTS ZERO
9010 FOR I=1 TO 12
9020 W1(I)=0
9030 NEXT I
9040 FOR I=1 TO 3
9050 B1(I)=0
9060 W2(I)=0
9070 NEXT I
9080 B2(1)=0
9090 RETURN
9100 REM LFSR INIT
9110 ST=SEED
9120 IF ST=0 THEN ST=1
9130 FOR I=1 TO 12
9140 GOSUB 9500
9150 W1(I)=W
9160 NEXT I
9170 FOR I=1 TO 3
9180 GOSUB 9500
9190 B1(I)=W
9192 GOSUB 9500
9194 W2(I)=W
9196 NEXT I
9198 GOSUB 9500
9199 B2(1)=W
9200 RETURN
9200 REM FORWARD PASS
9210 FOR I=1 TO NH
9220 S=B1(I)
9230 FOR J=1 TO NIN
9240 K=(I-1)*NIN+J
9250 A=X(J)
9260 B=W1(K)
9270 GOSUB 9600
9280 S=S+Q
9290 IF S>32767 THEN S=32767
9295 IF S<-32768 THEN S=-32768
9300 NEXT J
9305 IF S>255 THEN S=255
9310 IF S<-256 THEN S=-256
9320 H(I)=S
9330 NEXT I
9340 S=B2(1)
9350 FOR J=1 TO NH
9360 A=H(J)
9370 B=W2(J)
9380 GOSUB 9600
9390 S=S+Q
9395 IF S>32767 THEN S=32767
9398 IF S<-32768 THEN S=-32768
9400 NEXT J
9410 IF S>255 THEN S=255
9420 IF S<-256 THEN S=-256
9430 O=S
9440 RETURN
9500 REM LFSR STEP: ST -> ST, W=weight
9510 B14=INT(ST/16384)-(2*INT(ST/32768))
9520 B13=INT(ST/8192)-(2*INT(ST/16384))
9530 NB=B14-B13
9540 IF NB<0 THEN NB=-NB
9550 ST=ST*2+NB
9560 IF ST>=32768 THEN ST=ST-32768
9570 IF ST=0 THEN ST=1
9580 W=INT(ST/256)-64
9590 RETURN
9600 REM FXMUL: Q = A*B >> 8, round, clip
9610 P=A*B
9620 IF P=0 THEN Q=0:RETURN
9630 SG=1
9640 M=P
9650 IF M<0 THEN SG=-1:M=-M
9660 Q=INT(M/256)
9670 R=M-Q*256
9680 IF R>=128 THEN Q=Q+1
9690 Q=Q*SG
9700 IF Q>255 THEN Q=255
9710 IF Q<-256 THEN Q=-256
9720 RETURN
9300 REM BACKWARD/UPDATE STUB
9310 REM (FULL TRAINING IN TRAINER.BAS)
9320 RETURN
