TO CREATE.NETWORK
  MAKE "NET [ [INPUT X0 X1 X2 X3] [HIDDEN H0 H1 H2] [OUTPUT O0] ]
  MAKE "EDGES []
  MAKE "WEIGHTS []
  PRINT [NETWORK CREATED]
END

TO ADD.NODE :LAYER :NAME
  PRINT (SENTENCE [ADDED NODE] :NAME [TO] :LAYER)
END

TO ADD.EDGE :FROM :TO
  MAKE "EDGES LPUT (LIST :FROM :TO) :EDGES
  PRINT (SENTENCE [EDGE] :FROM [->] :TO)
END

TO SHOW.NETWORK
  PRINT :NET
  PRINT [EDGES:]
  PRINT :EDGES
END

TO TRAVERSE :NODE
  PRINT (SENTENCE [VISIT] :NODE)
END

TO DESCRIBE.LAYER :L
  IF :L = "INPUT [PRINT [INPUT LAYER: X0 X1 X2 X3]]
  IF :L = "HIDDEN [PRINT [HIDDEN LAYER: H0 H1 H2]]
  IF :L = "OUTPUT [PRINT [OUTPUT LAYER: O0]]
END

TO DESCRIBE.NEURON :N
  PRINT (SENTENCE [NEURON] :N)
END

TO EXPORT.PASCAL
  PRINT [(* Pascal topology export *)]
  PRINT [NInput := 4;]
  PRINT [NHidden := 3;]
  PRINT [NOutput := 1;]
END

TO EXPORT.BASIC
  PRINT [REM BASIC TOPOLOGY]
  PRINT [NIN=4]
  PRINT [NH=3]
  PRINT [NOUT=1]
END

TO BUILD.DEFAULT
  CREATE.NETWORK
  FOREACH [X0 X1 X2 X3] [ADD.EDGE ? "H0]
  FOREACH [X0 X1 X2 X3] [ADD.EDGE ? "H1]
  FOREACH [X0 X1 X2 X3] [ADD.EDGE ? "H2]
  FOREACH [H0 H1 H2] [ADD.EDGE ? "O0]
  PRINT [DEFAULT 4-3-1 TOPOLOGY BUILT]
END

TO COUNT.EDGES
  OUTPUT COUNT :EDGES
END

TO LIST.INCOMING :NEURON
  LOCAL "RESULT
  MAKE "RESULT []
  FOREACH :EDGES [
    IF (LAST ?) = :NEURON [MAKE "RESULT LPUT (FIRST ?) :RESULT]
  ]
  OUTPUT :RESULT
END

TO DEMO
  BUILD.DEFAULT
  SHOW.NETWORK
  DESCRIBE.LAYER "HIDDEN
  EXPORT.PASCAL
END
